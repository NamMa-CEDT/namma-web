# Copy to .env.local to override. Never commit secrets.

# mock = in-app mock API with real ThaiWater fixtures (default). http = real FastAPI backend.
VITE_API_MODE=mock

# Base URL of the API when VITE_API_MODE=http. Empty = same origin (dev server proxies /api to :8000).
VITE_API_BASE=

# Where the dev server proxies /api when VITE_API_MODE=http. Empty = http://localhost:8000.
# Point at the deployed VM to dev against live data: https://110.238.115.73.sslip.io
VITE_API_PROXY=

# LIFF app id (day 5, LINE Login). Public value, safe in the bundle.
VITE_LIFF_ID=

# Demo login (no password) against the real backend (needs DEMO_MODE=1 on the backend). Never in production.
VITE_DEMO_LOGIN=

# NamMa LINE OA add-friend link. Public. Empty = the live OA (https://line.me/R/ti/p/@753kmkri).
VITE_LINE_OA_URL=

# Google Sign-In: the OAuth client id (public). Empty = the account page says Google sign-in isn't set up.
VITE_GOOGLE_CLIENT_ID=
